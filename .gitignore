.env
*/node_modules
*/.venv
*/.idea
*/.vscode
.DS_Store
.audit/
reference/
__pycache__/

# voice_clone holds my own voice. Recordings and anything derived from them stay
# local; scripts/*.txt, analysis/*.py and the notebooks are tracked.
tts_models/voice_clone/recordings/
tts_models/voice_clone/dataset/

# No audio anywhere in this repo, at any depth. The per-directory rules above
# only covered voice_clone/, so two takes recorded straight to the repo root
# (mac_voice_isolation_mode.m4a, script_voice_iso_sample_test.m4a) sat unignored
# and `git add -A` would have published them. Every audio file that has appeared
# here has been a recording of my own voice, and this repo is public. No audio
# is tracked, so a blanket rule cannot break an existing file -- if a benchmark
# output ever does need tracking, unignore that one path explicitly.
*.wav
*.m4a
*.mp3
*.flac
*.aiff
*.aif
*.caf
*.ogg

# My own voice. Were tracked and public until the Sep 2026 history rewrite --
# keep them ignored so a `git add -A` cannot re-leak them.
sample_for_tts.m4a
stt_models/sample_for_tts.wav

# Raw Colab session log from the fine-tuning runs — contains the speaker name.
colab_browser_output.txt
